# Supabase プロジェクトの URL と publishable (anon) キー
# ダッシュボード: Project Settings > API Keys
# NEXT_PUBLIC_* はビルド時にクライアントへ埋め込まれる「公開してよい値」のみ
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- 以下はアプリ本体では使用しない (運営者用スクリプト scripts/process-account-deletions.mjs のみ) ----
# 絶対に NEXT_PUBLIC_ を付けない / Git にコミットしない / Cloudflare にも設定しない
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
